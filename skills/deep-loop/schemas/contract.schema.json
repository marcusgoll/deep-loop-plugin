{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deep Loop 2 Phase 1 Outcome Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "question", "build", "why", "prove", "route", "scope", "constraints", "authorization", "status", "acceptance", "blockers"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "build": {"type": "string", "minLength": 1},
    "why": {"type": "string", "minLength": 1},
    "prove": {"type": "string", "minLength": 1},
    "route": {"enum": ["small_fix", "bounded_feature", "architecture", "investigation"]},
    "scope": {"type": "object", "additionalProperties": false, "required": ["included", "excluded"], "properties": {"included": {"type": "array", "items": {"type": "string"}}, "excluded": {"type": "array", "items": {"type": "string"}}}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "authorization": {"enum": ["not_granted", "granted_for_scope"]},
    "status": {"enum": ["draft", "ready", "in_progress", "blocked", "verified"]},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "question", "method", "expected", "status", "evidence"], "properties": {"id": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "expected": {"type": "string", "minLength": 1}, "status": {"enum": ["pending", "passed", "failed", "blocked"]}, "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
